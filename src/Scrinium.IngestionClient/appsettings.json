{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Scrinium.IngestionClient": "Information"
    }
  },
  "Api": {
    "BaseUrl": "http://localhost:5243"
  },
  "Keycloak": {
    "TokenUrl": "https://localhost:8443/realms/scrinium/protocol/openid-connect/token",
    "ClientId": "scrinium-api",
    "ClientSecret": "",
    "Username": "devuser",
    "Password": "devpass",
    "Scope": "openid profile email"
  },
  "Watcher": {
    "WatchFolder": "",
    "PollIntervalMs": 2000,
    "StableChecksRequired": 3,
    "IncludeSubdirectories": false,
    "DefaultTags": [ "folder-watcher" ],
    "ProcessedSubfolder": "processed",
    "FailedSubfolder": "failed",
    "WaitForReady": true,
    "ReadyPollIntervalMs": 2000,
    "ReadyTimeoutSeconds": 300,
    "DownloadPreviewOnReady": false,
    "PreviewOutputFolder": "previews"
  }
}
