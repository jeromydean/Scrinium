{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=scrinium;Username=appuser;Password=secret"
  },
  "Ingestion": {
    "StagingPath": ""
  },
  "Keycloak": {
    "Authority": "https://localhost:8443/realms/scrinium",
    "Audience": "scrinium-api"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ConsumerGroupPrefix": "scrinium",
    "PendingMinIdleMs": 5000
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "scrinium",
    "UseSsl": false
  },
  "Workers": {
    "ConsumerName": "local-dev",
    "PollIntervalMs": 1000,
    "MaxPageRetries": 3,
    "MaxJobAttempts": 5
  },
  "Tika": {
    "BaseUrl": "http://localhost:9998",
    "TimeoutSeconds": 120
  },
  "Gotenberg": {
    "BaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 180
  },
  "Solr": {
    "BaseUrl": "https://localhost:8983/solr",
    "CoreName": "documents",
    "SkipCertificateValidation": true,
    "TimeoutSeconds": 60
  },
  "Rendering": {
    "PdfRenderDpi": 150,
    "WebpQuality": 80
  }
}
