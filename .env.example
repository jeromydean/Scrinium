# Copy to .env in the repo root:  copy .env.example .env
# Local development only — change all values before any shared or production use.

POSTGRES_USER=appuser
POSTGRES_PASSWORD=secret
POSTGRES_DB=postgres

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=secret
KEYCLOAK_HTTPS_KEY_STORE_PASSWORD=password
SOLR_SSL_KEY_STORE_PASSWORD=password

PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=secret

# If you change POSTGRES_PASSWORD, also update docker/pgadmin/pgpass so pgAdmin can connect.
