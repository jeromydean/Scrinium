{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scrinium.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Scrinium.Api/bin/Debug/net10.0/Scrinium.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Scrinium.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5243"
      }
    },
    {
      "name": "Scrinium.IngestionClient",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Scrinium.IngestionClient/bin/Debug/net10.0/Scrinium.IngestionClient.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Scrinium.IngestionClient",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Scrinium (UI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Scrinium/bin/Debug/net10.0/Scrinium.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Scrinium",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": [
        "Scrinium.Api",
        "Scrinium.IngestionClient",
        "Scrinium (UI)"
      ],
      "stopAll": true
    }
  ]
}
